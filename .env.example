# Optional licensed/partner freight feed. Expected JSON documented in docs/data-sources.md
RAIL_FEED_URL=
RAIL_FEED_TOKEN=

# Optional live Amtrak feed. The app always has official scheduled #3/#4 times as fallback.
AMTRAK_LIVE_FEED_URL=
AMTRAK_LIVE_FEED_TOKEN=

# Preferred live AIS source. Create a key at aisstream.io and keep it server-side.
AISSTREAM_API_KEY=

# Optional alternate HTTP AIS provider. Do not configure unless public/derived display is licensed.
# Expected JSON can be either an array or {"vessels": [...]} with MMSI, latitude/longitude,
# and optional vessel name, SOG/course/heading fields.
AIS_FEED_URL=
AIS_FEED_TOKEN=

# Override Corps Locks if endpoint changes.
LPMS_LOCK18_URL=https://corpslocks.usace.army.mil/lpwb/xml.lockqueue?in_river=MI&in_lock=18
LPMS_LOCK19_URL=https://corpslocks.usace.army.mil/lpwb/xml.lockqueue?in_river=MI&in_lock=19

NEXT_PUBLIC_SITE_URL=https://fort-madison-live.vercel.app

# Optional GA4 measurement ID (for example G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
